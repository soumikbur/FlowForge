model Policy {
  id                      String    @id @default(uuid())
  organizationId          String
  workspaceId             String?
  name                    String
  description             String?
  category                String    @default("WORKFLOW_SAFETY")
  version                 Int       @default(1)
  status                  String    @default("DRAFT")
  applicableResourceTypes String[]  @default([])
  applicableOperations    String[]  @default([])
  priority                Int       @default(100)
  effectiveStartDate      DateTime?
  effectiveEndDate        DateTime?
  rulesJson               String
  complianceControls      String[]  @default([])
  createdById             String
  lastModifiedById        String?
  approvedById            String?
  approvedAt              DateTime?
  changeSummary           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions                PolicyVersion[]
  exceptions              PolicyException[]
  violations              PolicyViolation[]

  @@index([organizationId, status])
  @@index([organizationId, workspaceId])
  @@map("policies")
}

model PolicyVersion {
  id             String   @id @default(uuid())
  policyId       String
  organizationId String
  version        Int
  definitionJson String
  approvedById   String
  approvedAt     DateTime @default(now())
  changeSummary  String?
  createdAt      DateTime @default(now())

  policy         Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([organizationId])
  @@map("policy_versions")
}

model PolicyException {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String?
  policyId       String
  policyVersion  Int
  ruleId         String?
  resourceType   String
  resourceId     String
  operation      String
  reason         String
  status         String    @default("PENDING")
  requestedById  String
  approvedById   String?
  approvedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy         Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([resourceType, resourceId])
  @@map("policy_exceptions")
}

model PolicyViolation {
  id               String    @id @default(uuid())
  organizationId   String
  workspaceId      String?
  policyId         String
  policyVersion    Int
  ruleId           String
  resourceType     String
  resourceId       String
  operation        String
  severity         String    @default("HIGH")
  reasonCode       String
  message          String
  status           String    @default("OPEN")
  assignedToId     String?
  remediationNotes String?
  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  policy           Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([resourceType, resourceId])
  @@map("policy_violations")
}

