enum PlanBillingInterval {
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model Plan {
  id              String              @id
  slug            String              @unique
  name            String
  description     String
  billingInterval PlanBillingInterval @default(MONTHLY)
  priceCents      Int
  currency        String              @default("USD")
  trialDays       Int                 @default(0)
  status          PlanStatus          @default(ACTIVE)
  entitlements    Json
  metadata        Json?               @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String              @id @default(uuid())
  organizationId         String
  planId                 String
  providerCustomerId     String?
  providerSubscriptionId String?             @unique
  status                 SubscriptionStatus  @default(ACTIVE)
  billingInterval        PlanBillingInterval @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAtPeriodEnd      Boolean             @default(false)
  canceledAt             DateTime?
  gracePeriodEnd         DateTime?
  metadata               Json?               @default("{}")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  usageRecords UsageRecord[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

model UsageRecord {
  id             String    @id @default(uuid())
  organizationId String
  subscriptionId String?
  metric         String
  quantity       Int       @default(1)
  idempotencyKey String?
  periodStart    DateTime
  periodEnd      DateTime
  metadata       Json?     @default("{}")
  recordedAt     DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, metric, idempotencyKey])
  @@index([organizationId, metric, periodStart, periodEnd])
  @@map("usage_records")
}

model Invoice {
  id                 String        @id @default(uuid())
  organizationId     String
  subscriptionId     String?
  providerInvoiceId  String?       @unique
  invoiceNumber      String
  currency           String        @default("USD")
  subtotal           Int
  tax                Int           @default(0)
  total              Int
  amountPaid         Int           @default(0)
  status             InvoiceStatus @default(DRAFT)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  invoicePdfUrl      String?
  hostedInvoiceUrl   String?
  issuedAt           DateTime      @default(now())
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("invoices")
}

model BillingWebhookEvent {
  id              String               @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  status          BillingWebhookStatus @default(RECEIVED)
  processedAt     DateTime?
  error           String?
  createdAt       DateTime             @default(now())

  @@unique([provider, providerEventId])
  @@map("billing_webhook_events")
}

