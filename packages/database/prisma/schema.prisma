datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TriggerType {
  MANUAL
  WEBHOOK
  SCHEDULE
  EVENT
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  WAITING_DELAY
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  WAITING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  TIMEOUT
}

enum CredentialType {
  SMTP
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
}

enum ConnectionStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum TemplateVisibility {
  PRIVATE
  ORGANIZATION
  PLATFORM
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CollaboratorRole {
  MAINTAINER
  EDITOR
  VIEWER
}

enum WorkflowActivityType {
  WORKFLOW_CREATED
  DRAFT_UPDATED
  WORKFLOW_PUBLISHED
  OWNERSHIP_TRANSFERRED
  COLLABORATOR_ADDED
  COLLABORATOR_REMOVED
  COLLABORATOR_ROLE_UPDATED
  COMMENT_ADDED
  COMMENT_RESOLVED
  COMMENT_DELETED
}

model Organization {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  timezone               String   @default("UTC")
  billingEmail           String?
  enforce2FA             Boolean  @default(false)
  allowedIpRanges        Json     @default("[]")
  executionRetentionDays Int      @default(90)
  auditRetentionDays     Int      @default(365)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  memberships    OrganizationMembership[]
  workflows      Workflow[]
  executions     WorkflowExecution[]
  approvals      Approval[]
  credentials    IntegrationCredential[]
  webhooks       WebhookEvent[]
  webhookConfigs WebhookConfig[]
  schedules      WorkflowSchedule[]
  deployments    WorkflowDeployment[]
  auditLogs      AuditLog[]
  alerts         OperationalAlert[]
  incidents      OperationalIncident[]
  invitations    OrganizationInvitation[]
  apiKeys        ApiKey[]
  connections    IntegrationConnection[]
  templates      WorkflowTemplate[]
  collaborators  WorkflowCollaborator[]
  comments       WorkflowComment[]
  activities     WorkflowActivity[]
  outboxEvents   OutboxEvent[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]
  webhookSubscriptions    WebhookSubscription[]
  webhookDeliveries       WebhookDelivery[]
  workflowImports         WorkflowImport[]
  subscriptions           Subscription[]
  usageRecords            UsageRecord[]
  invoices                Invoice[]
  workspaces              Workspace[]
  branding                OrganizationBranding?
  customDomains           CustomDomain[]
  enterpriseLicense       EnterpriseLicense?
  ssoConfiguration        SsoConfiguration?
  externalIdentities      ExternalIdentity[]
  groupRoleMappings       GroupRoleMapping[]
  scimTokens              ScimToken[]
  oauthClients            OAuthClient[]
  idempotencyRecords      IdempotencyRecord[]
  retentionPolicies       RetentionPolicy[]
  retentionJobs           RetentionJob[]
  privacyRequests         PrivacyRequest[]
  legalHolds              LegalHold[]
  aiConfiguration         AiConfiguration?
  slos                    WorkflowSlo[]
  businessOutcomes        BusinessOutcome[]
  processEvents           ProcessEvent[]
  streamEvents            StreamEvent[]
  eventDeduplications     EventDeduplication[]
  connectorSubscriptions  ConnectorSubscription[]
  extensionInstallations  ExtensionInstallation[]
  savedSearches           SavedSearch[]
  policies                Policy[]
  policyExceptions        PolicyException[]
  policyViolations        PolicyViolation[]
  roiAssumptions          RoiAssumption[]
  savedReports            SavedReport[]
  resourceQuotas          ResourceQuota[]
  workflowTestCases       WorkflowTestCase[]
  workflowTestRuns        WorkflowTestRun[]
  testFixtures            TestFixture[]
  publishingGateConfigs   PublishingGateConfig[]

  @@map("organizations")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       OrganizationMembership[]
  sessions          Session[]
  createdWorkflows  Workflow[]               @relation("WorkflowCreator")
  publishedVersions WorkflowVersion[]        @relation("VersionPublisher")
  decidedApprovals  Approval[]               @relation("ApprovalDecider")
  assignedApprovals Approval[]               @relation("ApprovalAssignee")
  deployments       WorkflowDeployment[]     @relation("DeploymentDeployer")
  auditLogs         AuditLog[]
  resolvedAlerts    OperationalAlert[]       @relation("AlertResolver")
  resolvedIncidents OperationalIncident[]    @relation("IncidentResolver")
  assignedIncidents OperationalIncident[]    @relation("IncidentAssignee")
  sentInvitations   OrganizationInvitation[] @relation("InvitationInviter")
  createdApiKeys    ApiKey[]                 @relation("ApiKeyCreator")
  createdConnections IntegrationConnection[] @relation("ConnectionCreator")
  createdTemplates  WorkflowTemplate[]       @relation("TemplateCreator")
  publishedTemplateVersions WorkflowTemplateVersion[] @relation("TemplateVersionPublisher")
  collaborations    WorkflowCollaborator[]
  comments          WorkflowComment[]
  resolvedComments  WorkflowComment[]        @relation("CommentResolver")
  activities        WorkflowActivity[]
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  workflowImports   WorkflowImport[]         @relation("ImportedByUser")
  workspaceMemberships WorkspaceMember[]
  createdWorkspaces Workspace[]              @relation("WorkspaceCreator")
  externalIdentities ExternalIdentity[]
  privacyRequests   PrivacyRequest[]
  reviewedPrivacyRequests PrivacyRequest[]     @relation("PrivacyReviewer")
  createdLegalHolds LegalHold[]                @relation("LegalHoldCreator")
  releasedLegalHolds LegalHold[]               @relation("LegalHoldReleaser")
  savedSearches     SavedSearch[]

  @@map("users")
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Workflow {
  id                 String         @id @default(uuid())
  organizationId     String
  name               String
  description        String?
  status             WorkflowStatus @default(DRAFT)
  draftDefinition    Json           @default("{\"nodes\":[],\"edges\":[]}")
  draftRevision      Int            @default(1)
  publishedVersionId String?
  createdById        String?
  lastUpdatedById    String?
  sourceTemplateId   String?
  sourceTemplateVersionId String?
  workspaceId        String?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User?          @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceTemplate     WorkflowTemplate? @relation("TemplateWorkflows", fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  workspace          Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  versions           WorkflowVersion[]
  executions         WorkflowExecution[]
  webhooks           WebhookEvent[]
  webhookConfigs     WebhookConfig[]
  schedules          WorkflowSchedule[]
  deployments        WorkflowDeployment[]
  alerts             OperationalAlert[]
  incidents          OperationalIncident[]
  collaborators      WorkflowCollaborator[]
  comments           WorkflowComment[]
  activities         WorkflowActivity[]
  imports            WorkflowImport[]
  slos               WorkflowSlo[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([sourceTemplateId])
  @@index([deletedAt])
  @@index([organizationId, deletedAt, updatedAt])
  @@index([organizationId, status, updatedAt])
  @@map("workflows")
}

model WorkflowVersion {
  id            String   @id @default(uuid())
  workflowId    String
  versionNumber Int
  definition    Json
  contentHash   String?
  releaseNotes  String?
  publishedAt   DateTime @default(now())
  publishedById String?

  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  publishedBy   User?    @relation("VersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  executions    WorkflowExecution[]
  deployments   WorkflowDeployment[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id                String          @id @default(uuid())
  organizationId    String
  workflowId        String
  workflowVersionId String
  environment       String          @default("development")
  triggerType       TriggerType
  triggerPayload    Json            @default("{}")
  status            ExecutionStatus @default(QUEUED)
  contextData       Json            @default("{}")
  currentNodeId     String?
  startedAt         DateTime?
  completedAt       DateTime?
  retryCount        Int             @default(0)
  errorDetails      Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow          Workflow        @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  steps             ExecutionStep[]
  approvals         Approval[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, workflowId, createdAt])
  @@index([status, updatedAt])
  @@index([organizationId, workflowId, status, createdAt])
  @@map("workflow_executions")
}

model WorkflowDeployment {
  id                 String   @id @default(uuid())
  organizationId     String
  workflowId         String
  workflowVersionId  String
  environment        String   @default("development")
  status             String   @default("ACTIVE")
  deployedById       String?
  deployedAt         DateTime @default(now())
  previousVersionId  String?
  releaseNotes       String?
  rollbackReason     String?
  idempotencyKey     String?

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow           Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion    WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  deployedBy         User?            @relation("DeploymentDeployer", fields: [deployedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workflowId, environment])
  @@index([status])
  @@map("workflow_deployments")
}

model ExecutionStep {
  id            String     @id @default(uuid())
  executionId   String
  nodeId        String
  nodeType      String
  nodeName      String
  status        StepStatus @default(PENDING)
  inputPayload  Json?
  outputPayload Json?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  attempt       Int        @default(1)

  execution     WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approvals     Approval[]

  @@index([executionId])
  @@index([nodeId])
  @@index([executionId, status])
  @@index([nodeType])
  @@index([executionId, startedAt])
  @@map("execution_steps")
}

model Approval {
  id              String         @id @default(uuid())
  organizationId  String
  executionId     String
  stepId          String
  title           String
  description     String?
  requiredRole    Role           @default(ADMIN)
  status          ApprovalStatus @default(PENDING)
  decisionComment String?
  decidedById     String?
  decidedAt       DateTime?
  assignedUserId  String?
  expiresAt       DateTime?
  timeoutPolicy   String?        @default("REJECT")
  createdAt       DateTime       @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution      WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step           ExecutionStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  decidedBy      User?             @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  assignedUser   User?             @relation("ApprovalAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([executionId])
  @@index([status])
  @@index([assignedUserId])
  @@index([expiresAt])
  @@map("approvals")
}

model IntegrationCredential {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  type           CredentialType
  encryptedData  String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("integration_credentials")
}

model IntegrationConnection {
  id             String           @id @default(uuid())
  organizationId String
  connectorId    String
  name           String
  status         ConnectionStatus @default(ACTIVE)
  authType       String           @default("API_KEY")
  encryptedData  String
  metadata       Json             @default("{}")
  lastTestedAt   DateTime?
  lastTestStatus String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("ConnectionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([connectorId])
  @@index([status])
  @@map("integration_connections")
}

model WebhookEvent {
  id             String   @id @default(uuid())
  organizationId String
  workflowId     String
  idempotencyKey String?
  source         String?
  payload        Json
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([workflowId])
  @@map("webhook_events")
}

model WebhookConfig {
  id                     String    @id @default(uuid())
  organizationId         String
  workflowId             String
  name                   String
  enabled                Boolean   @default(true)
  signingSecret          String
  secondarySigningSecret String?
  secretRotatedAt        DateTime?
  eventFilter            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@map("webhook_configs")
}

model WorkflowSchedule {
  id             String    @id @default(uuid())
  organizationId String
  workflowId     String
  name           String
  cronExpression String?
  scheduledAt    DateTime?
  timezone       String    @default("UTC")
  enabled        Boolean   @default(true)
  misfirePolicy  String    @default("RUN_ONCE")
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@index([enabled, nextRunAt])
  @@map("workflow_schedules")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  workspaceId    String?
  userId         String?
  actorType      String   @default("USER") // USER | API_KEY | OAUTH_CLIENT | SYSTEM
  actorId        String?
  authMethod     String?
  action         String
  resourceType   String
  resourceId     String
  outcome        String   @default("SUCCESS") // SUCCESS | FAILURE | DENIED
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  recordHash     String?
  prevRecordHash String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType])
  @@index([organizationId, action])
  @@map("audit_logs")
}

model OperationalAlert {
  id             String    @id @default(uuid())
  organizationId String
  workflowId     String?
  ruleType       String    // HIGH_FAILURE_RATE | CONSECUTIVE_FAILURES | QUEUE_BACKLOG | SCHEDULER_LAG | WORKER_UNAVAILABLE | APPROVAL_TIMEOUT_SURGE
  severity       String    @default("WARNING") // INFO | WARNING | CRITICAL
  status         String    @default("ACTIVE")  // ACTIVE | RESOLVED
  title          String
  message        String
  contextJson    Json?
  triggeredAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  dedupKey       String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow?    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  resolvedBy     User?        @relation("AlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, triggeredAt])
  @@index([dedupKey])
  @@map("operational_alerts")
}

model OperationalIncident {
  id                String    @id @default(uuid())
  organizationId    String
  title             String
  description       String
  severity          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status            String    @default("OPEN")   // OPEN | INVESTIGATING | MITIGATED | RESOLVED
  affectedService   String    // api | worker | database | scheduler | connector
  workflowId        String?
  fingerprint       String?
  occurrenceCount   Int       @default(1)
  correlationIds    String[]
  firstObservedAt   DateTime  @default(now())
  lastObservedAt    DateTime  @default(now())
  assignedToId      String?
  resolutionSummary String?
  resolvedAt        DateTime?
  resolvedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow          Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  assignedTo        User?        @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy        User?        @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, fingerprint])
  @@map("operational_incidents")
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role             @default(MEMBER)
  tokenHash      String           @unique
  inviterId      String
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User             @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([tokenHash])
  @@index([email])
  @@map("organization_invitations")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  workspaceId    String?
  name           String
  keyPrefix      String
  keyHash        String    @unique
  scopes         Json      @default("[]")
  createdById    String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@map("api_keys")
}

model WorkflowTemplate {
  id                  String             @id @default(uuid())
  organizationId      String?
  name                String
  shortDescription    String
  description         String?
  category            String             @default("General")
  tags                Json               @default("[]")
  visibility          TemplateVisibility @default(PRIVATE)
  status              TemplateStatus     @default(DRAFT)
  draftDefinition     Json               @default("{\"nodes\":[],\"edges\":[]}")
  requiredConnections Json               @default("[]")
  requiredInputs      Json               @default("{}")
  usageCount          Int                @default(0)
  isFeatured          Boolean            @default(false)
  isVerified          Boolean            @default(false)
  createdById         String?
  publishedVersionId  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy           User?              @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions            WorkflowTemplateVersion[]
  instantiatedWorkflows Workflow[]       @relation("TemplateWorkflows")

  @@index([organizationId])
  @@index([visibility])
  @@index([status])
  @@index([category])
  @@map("workflow_templates")
}

model WorkflowTemplateVersion {
  id                  String           @id @default(uuid())
  templateId          String
  versionNumber       Int
  definition          Json
  requiredConnections Json             @default("[]")
  requiredInputs      Json             @default("{}")
  contentHash         String
  releaseNotes        String?
  publishedById       String?
  publishedAt         DateTime         @default(now())

  template            WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  publishedBy         User?            @relation("TemplateVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@map("workflow_template_versions")
}

model WorkflowCollaborator {
  id             String           @id @default(uuid())
  organizationId String
  workflowId     String
  userId         String
  role           CollaboratorRole @default(EDITOR)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workflowId, userId])
  @@index([organizationId])
  @@index([workflowId])
  @@index([userId])
  @@map("workflow_collaborators")
}

model WorkflowComment {
  id             String           @id @default(uuid())
  organizationId String
  workflowId     String
  userId         String
  content        String
  nodeId         String?
  parentId       String?
  draftRevision  Int?
  isResolved     Boolean          @default(false)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         WorkflowComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        WorkflowComment[] @relation("CommentReplies")
  resolvedBy     User?            @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workflowId])
  @@index([userId])
  @@index([parentId])
  @@index([isResolved])
  @@index([workflowId, createdAt])
  @@map("workflow_comments")
}

model WorkflowActivity {
  id             String               @id @default(uuid())
  organizationId String
  workflowId     String
  userId         String?
  type           WorkflowActivityType
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now())

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow       Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([workflowId, createdAt])
  @@index([userId])
  @@index([type])
  @@map("workflow_activities")
}

model OutboxEvent {
