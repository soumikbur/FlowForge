// ==========================================
// ENTERPRISE SSO, SAML, OIDC & SCIM
// ==========================================

enum SsoProtocol {
  OIDC
  SAML
}

enum SsoEnforcementMode {
  OPTIONAL
  ENFORCED
  STRICT
}

enum ProvisioningSource {
  LOCAL
  SSO
  SCIM
  INVITATION
}

model SsoConfiguration {
  id                 String             @id @default(uuid())
  organizationId     String             @unique
  name               String
  protocol           SsoProtocol
  enabled            Boolean            @default(true)
  enforcementMode    SsoEnforcementMode @default(OPTIONAL)
  bypassUserIds      Json               @default("[]")
  allowIdpInitiated  Boolean            @default(false)
  defaultRole        Role               @default(MEMBER)
  issuerUrl          String?
  clientId           String?
  clientSecret       String?
  authorizationUrl   String?
  tokenUrl           String?
  userInfoUrl        String?
  scopes             Json               @default("[\"openid\",\"profile\",\"email\"]")
  entityId           String?
  signOnUrl          String?
  signingCertificate String?
  spEntityId         String?
  acsUrl             String?
  attributeMapping   Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupRoleMappings  GroupRoleMapping[]

  @@map("sso_configurations")
}

model ExternalIdentity {
  id                 String             @id @default(uuid())
  organizationId     String
  userId             String
  providerId         String
  protocol           SsoProtocol
  externalSubject    String
  externalIssuer     String
  email              String
  provisioningSource ProvisioningSource @default(SSO)
  claims             Json               @default("{}")
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalSubject])
  @@unique([organizationId, userId, providerId])
  @@index([organizationId])
  @@index([userId])
  @@map("external_identities")
}

model GroupRoleMapping {
  id                 String           @id @default(uuid())
  organizationId     String
  ssoConfigurationId String
  externalGroupName  String
  targetRole         Role             @default(MEMBER)
  workspaceMappings  Json             @default("[]")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ssoConfiguration   SsoConfiguration @relation(fields: [ssoConfigurationId], references: [id], onDelete: Cascade)

  @@unique([ssoConfigurationId, externalGroupName])
  @@index([organizationId])
  @@map("group_role_mappings")
}

model ScimToken {
