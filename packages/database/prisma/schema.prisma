  declaredCapabilities       Json     @default("[]")
  status                     String   @default("APPROVED")
  releaseNotes               String?
  createdAt                  DateTime @default(now())

  extension                  ExtensionPackage @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, version])
  @@index([extensionId])
  @@map("extension_versions")
}

