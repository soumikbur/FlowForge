# ==============================================================================
# FlowForge Platform Environment Configuration Reference
# ==============================================================================
# WARNING: NEVER commit real production secrets or credentials to source control.
# Copy this template to .env for local development or .env.production for production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Environment
# ------------------------------------------------------------------------------
# Applicable environments: development, test, staging, production
# In production/staging, strict cryptographic and connection invariants are enforced.
NODE_ENV=development

# Logging severity: debug, info, warn, error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Required in all environments.
# In production/staging, MUST start with postgresql:// or postgres:// (cannot be file: or in-memory)
DATABASE_URL="postgresql://flowforge:flowforge_password@localhost:5432/flowforge_db?schema=public"

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. Redis & Queue Infrastructure
# ------------------------------------------------------------------------------
# Required for worker task queue, rate limiting, and execution locks.
# In production, use TLS connection string (rediss://) where supported.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. API & Worker Server Ports & Network URLs
# ------------------------------------------------------------------------------
# API server port and public base URL
PORT=4000
API_URL="http://localhost:4000"

# Background worker HTTP health & metrics port
WORKER_PORT=4001

# Web frontend application public URL (used for CORS and redirect resolution)
WEB_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Security, Cryptography & Authentication Keys (CONFIDENTIAL)
# ------------------------------------------------------------------------------
# SESSION_SECRET: Cookie signing secret.
# In production: MUST be at least 32 characters of high-entropy random data.
# Example generation: openssl rand -base64 32
SESSION_SECRET="flowforge-super-secret-session-key-change-in-production-min-32-chars"

# ENCRYPTION_KEY: 256-bit AES-GCM credential encryption key.
# In production: MUST be exactly 64 hexadecimal characters (32 bytes).
# Example generation: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT_SECRET: Token signing secret for internal worker & webhook verification.
# In production: MUST be at least 32 characters.
JWT_SECRET="flowforge-jwt-secret-token-key-change-in-production"

# ------------------------------------------------------------------------------
# 6. API Rate Limiting & Abuse Controls
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 7. Frontend Public Variables (Safe for Browser Bundles)
# ------------------------------------------------------------------------------
# ONLY variables prefixed with NEXT_PUBLIC_ are exposed to the browser client.
NEXT_PUBLIC_API_URL="http://localhost:4000"
