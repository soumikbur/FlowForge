# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://flowforge:flowforge_password@localhost:5432/flowforge_db?schema=public"

# Redis Queue Configuration
REDIS_URL="redis://localhost:6379"

# API & Worker Server Ports
PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
WORKER_PORT=4001

# Security & Secrets
SESSION_SECRET="flowforge-super-secret-session-key-change-in-production-min-32-chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="flowforge-jwt-secret-token-key-change-in-production"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL="info"
NODE_ENV="development"
